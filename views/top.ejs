<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" sizes="16x16" href="/image/favicon.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Top Companies 🚀 — PlacementOS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #f0ede8;
      --surface: #ffffff;
      --border: #e2ddd7;
      --text-primary: #1a1714;
      --text-secondary: #7a7269;
      --accent: #d4522a;
      --accent-light: #f5ede9;
      --shadow-sm: 0 2px 8px rgba(0,0,0,.06);
      --shadow-hover: 0 20px 50px rgba(0,0,0,.14);
      --radius: 16px;
      --transition: cubic-bezier(.25,.46,.45,.94);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background-color: var(--bg);
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    .page-wrapper {
      position: relative;
      z-index: 1;
      max-width: 1160px;
      margin: 0 auto;
      padding: 64px 32px 96px;
    }

    .page-header {
      text-align: center;
      margin-bottom: 52px;
    }

    .eyebrow {
      display: inline-block;
      font-family: 'DM Sans', sans-serif;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-light);
      padding: 5px 14px;
      border-radius: 999px;
      margin-bottom: 20px;
    }

    .page-title {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2.4rem, 5vw, 3.8rem);
      font-weight: 800;
      letter-spacing: -.03em;
      line-height: 1.05;
      color: var(--text-primary);
      margin-bottom: 14px;
    }

    .page-subtitle {
      font-size: 1rem;
      font-weight: 300;
      color: var(--text-secondary);
      max-width: 400px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .controls-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 40px;
    }

    .search-box {
      position: relative;
      flex: 1 1 280px;
      max-width: 420px;
    }

    .search-icon {
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      color: var(--text-secondary);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      padding: 13px 20px 13px 48px;
      border: 1.5px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      font-family: 'DM Sans', sans-serif;
      font-size: .93rem;
      color: var(--text-primary);
      box-shadow: var(--shadow-sm);
      outline: none;
      transition: border-color .2s var(--transition), box-shadow .2s var(--transition);
    }

    .search-input::placeholder { color: var(--text-secondary); }

    .search-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px rgba(212,82,42,.10), var(--shadow-sm);
    }

    .filter-tabs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filter-btn {
      padding: 8px 16px;
      border: 1.5px solid var(--border);
      border-radius: 999px;
      background: var(--surface);
      font-family: 'DM Sans', sans-serif;
      font-size: .8rem;
      font-weight: 500;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all .2s var(--transition);
      white-space: nowrap;
    }

    .filter-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .filter-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .result-count {
      font-size: .82rem;
      color: var(--text-secondary);
      margin-bottom: 20px;
      padding-left: 2px;
    }

    .result-count span {
      font-weight: 600;
      color: var(--accent);
    }

    .company-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .company-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 32px 20px 26px;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      text-decoration: none;
      color: var(--text-primary);
      box-shadow: var(--shadow-sm);
      transition: transform .32s var(--transition), box-shadow .32s var(--transition), border-color .22s var(--transition);
      position: relative;
      overflow: hidden;
      cursor: pointer;
      opacity: 0;
      animation: fadeUp .45s var(--transition) forwards;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .company-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(212,82,42,.06) 0%, transparent 60%);
      opacity: 0;
      transition: opacity .3s var(--transition);
    }

    .company-card:hover {
      transform: translateY(-6px) scale(1.025);
      box-shadow: var(--shadow-hover);
      border-color: rgba(212,82,42,.35);
    }

    .company-card:hover::before { opacity: 1; }

    .company-card.hidden { display: none; }

    .logo-wrap {
      width: 66px;
      height: 66px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: var(--bg);
      transition: background .3s var(--transition);
      flex-shrink: 0;
    }

    .company-card:hover .logo-wrap { background: var(--accent-light); }

    .logo-wrap svg {
      width: 38px;
      height: 38px;
      transition: transform .3s var(--transition);
    }

    .company-card:hover .logo-wrap svg { transform: scale(1.12); }

    .company-name {
      font-family: 'Syne', sans-serif;
      font-size: .95rem;
      font-weight: 700;
      letter-spacing: -.01em;
      color: var(--text-primary);
      text-align: center;
    }

    .company-tag {
      font-size: .72rem;
      font-weight: 400;
      color: var(--text-secondary);
      letter-spacing: .04em;
      text-align: center;
    }

    .card-arrow {
      position: absolute;
      top: 13px;
      right: 16px;
      font-size: .85rem;
      color: var(--border);
      transition: color .25s, transform .25s var(--transition);
    }

    .company-card:hover .card-arrow {
      color: var(--accent);
      transform: translate(3px, -3px);
    }

    .no-results {
      display: none;
      text-align: center;
      padding: 60px 20px;
      color: var(--text-secondary);
      font-size: .95rem;
      grid-column: 1 / -1;
    }

    .no-results.visible { display: block; }

    @media (max-width: 860px) {
      .company-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 560px) {
      .page-wrapper { padding: 40px 16px 72px; }
      .company-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .controls-row { flex-direction: column; align-items: stretch; }
      .search-box { max-width: 100%; }
    }

    @media (max-width: 380px) {
      .company-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
