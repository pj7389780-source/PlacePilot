<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/png" sizes="16x16" href="/image/favicon.png">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password — Axiom</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:        #0c0c0e;
      --panel:     #111114;
      --border:    rgba(255,255,255,0.07);
      --muted:     #3a3a44;
      --text:      #e8e8ec;
      --subtle:    #7a7a8c;
      --accent:    #4f7cff;
      --accent-lo: rgba(79,124,255,0.12);
      --gold:      #c9a96e;
      --success:   #3ecf8e;
      --success-lo:rgba(62,207,142,0.1);
      --error:     #f87171;
      --error-lo:  rgba(248,113,113,0.1);
      --radius:    12px;
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body:    'DM Sans', system-ui, sans-serif;
    }

    html, body {
      height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 15px;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Shell ── */
    .shell {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }

    /* ── LEFT ── */
    .left {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 52px 56px;
      background: var(--panel);
      border-right: 1px solid var(--border);
      overflow: hidden;
    }

    .left::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 55% 55% at 20% 70%, rgba(79,124,255,0.08) 0%, transparent 70%),
        radial-gradient(ellipse 45% 40% at 80% 20%, rgba(201,169,110,0.07) 0%, transparent 60%);
      pointer-events: none;
    }

    .left::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 40px 40px;
      mask-image: radial-gradient(ellipse 80% 70% at 40% 55%, black 20%, transparent 80%);
      pointer-events: none;
    }

    .brand { position: relative; z-index: 1; }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }

    .logo-mark {
      width: 36px; height: 36px;
      border: 1.5px solid var(--gold);
      border-radius: 8px;
      display: grid;
      place-items: center;
    }

    .logo-name {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--text);
    }

    /* Steps indicator */
    .steps-block { position: relative; z-index: 1; }

    .steps-label {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 28px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .steps-label::before {
      content: '';
      display: block;
      width: 24px; height: 1px;
      background: var(--gold);
    }

    .steps { display: flex; flex-direction: column; gap: 0; }

    .step {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding-bottom: 32px;
      position: relative;
    }

    .step:last-child { padding-bottom: 0; }

    /* vertical line between steps */
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 15px;
      top: 32px;
      width: 1px;
      height: calc(100% - 32px);
      background: var(--border);
    }

    .step-dot {
      width: 32px; height: 32px;
      border-radius: 50%;
      border: 1.5px solid var(--border);
      display: grid;
      place-items: center;
      flex-shrink: 0;
      font-size: 12px;
      font-weight: 500;
      color: var(--subtle);
      background: var(--panel);
      position: relative;
      z-index: 1;
      transition: border-color 0.3s, color 0.3s;
    }

    .step.active .step-dot {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--accent-lo);
      box-shadow: 0 0 0 4px rgba(79,124,255,0.08);
    }

    .step.done .step-dot {
      border-color: var(--success);
      color: var(--success);
      background: var(--success-lo);
    }

    .step-body { padding-top: 4px; }

    .step-title {
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
      margin-bottom: 3px;
    }

    .step.inactive .step-title { color: var(--subtle); }

    .step-desc {
      font-size: 12px;
      color: var(--subtle);
      line-height: 1.6;
    }

    .footer-note {
      position: relative;
      z-index: 1;
      font-size: 11px;
      color: var(--muted);
    }

    /* ── RIGHT ── */
    .right {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 52px 72px;
    }

    /* ── Flash messages (EJS rendered) ── */
    .flash {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      border-radius: var(--radius);
      font-size: 13px;
      line-height: 1.55;
      margin-bottom: 28px;
      animation: fadeUp 0.4s ease both;
    }

    .flash-success {
      background: var(--success-lo);
      border: 1px solid rgba(62,207,142,0.2);
      color: var(--success);
    }

    .flash-error {
      background: var(--error-lo);
      border: 1px solid rgba(248,113,113,0.2);
      color: var(--error);
    }

    .flash svg { flex-shrink: 0; margin-top: 1px; }

    /* ── Sent state ── */
    .sent-view {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      animation: fadeUp 0.5s ease both;
    }

    .sent-view.visible { display: flex; }

    .sent-icon {
      width: 64px; height: 64px;
      border-radius: 50%;
      background: var(--success-lo);
      border: 1px solid rgba(62,207,142,0.25);
      display: grid;
      place-items: center;
      margin-bottom: 24px;
    }

    .sent-title {
      font-family: var(--font-display);
      font-size: 32px;
      font-weight: 400;
      margin-bottom: 12px;
    }

    .sent-desc {
      font-size: 14px;
      color: var(--subtle);
      line-height: 1.7;
      max-width: 340px;
      margin-bottom: 28px;
    }

    .sent-email-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      border-radius: 99px;
      font-size: 13px;
      color: var(--text);
      margin-bottom: 28px;
    }

    .resend-row {
      font-size: 13px;
      color: var(--subtle);
    }

    .resend-row button {
      background: none;
      border: none;
      color: var(--accent);
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      padding: 0;
    }

    .resend-row button:hover { text-decoration: underline; }

    /* ── Form view ── */
    .form-view { animation: fadeUp 0.5s ease both; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 12.5px;
      color: var(--subtle);
      text-decoration: none;
      margin-bottom: 32px;
      transition: color 0.2s;
    }

    .back-link:hover { color: var(--text); }

    .form-tag {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 10px;
    }

    .form-title {
      font-family: var(--font-display);
      font-size: 38px;
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1.15;
      margin-bottom: 8px;
    }

    .form-title em { font-style: italic; color: var(--gold); }

    .form-desc {
      font-size: 13px;
      color: var(--subtle);
      line-height: 1.65;
      margin-bottom: 34px;
      max-width: 360px;
    }

    /* ── Field ── */
    .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }

    .field label {
      font-size: 11.5px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--subtle);
    }

    .field-wrap { position: relative; }

    .field-wrap .icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 15px; height: 15px;
      color: var(--muted);
      pointer-events: none;
      transition: color 0.2s;
      z-index: 1;
    }

    .field input {
      width: 100%;
      padding: 13px 14px 13px 42px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 300;
      outline: none;
      transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
      position: relative;
      z-index: 2;
    }

    .field input::placeholder { color: var(--muted); }

    .field input:focus {
      border-color: var(--accent);
      background: var(--accent-lo);
      box-shadow: 0 0 0 3px rgba(79,124,255,0.1);
    }

    .field-wrap:has(input:focus) .icon { color: var(--accent); }

    .field-hint {
      font-size: 11.5px;
      color: var(--muted);
      margin-top: 5px;
      line-height: 1.5;
    }

    /* ── Submit ── */
    .btn-submit {
      width: 100%;
      padding: 14px;
      background: var(--accent);
      border: none;
      border-radius: var(--radius);
      color: #fff;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.04em;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
      box-shadow: 0 4px 24px rgba(79,124,255,0.28);
      margin-bottom: 18px;
    }

    .btn-submit::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.12), transparent);
      pointer-events: none;
    }

    .btn-submit:hover {
      opacity: 0.92;
      transform: translateY(-1px);
      box-shadow: 0 6px 30px rgba(79,124,255,0.38);
    }

    .btn-submit:active { transform: translateY(0); }

    /* loading spinner inside button */
    .btn-submit .spinner {
      display: none;
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.65s linear infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .btn-submit.loading .btn-text { display: none; }
    .btn-submit.loading .spinner  { display: block; }

    .btn-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    /* ── Footer ── */
    .form-footer {
      text-align: center;
      font-size: 13px;
      color: var(--subtle);
    }

    .form-footer a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
    }

    .form-footer a:hover { text-decoration: underline; }

    /* ── Responsive ── */
    @media (max-width: 860px) {
      .shell { grid-template-columns: 1fr; }
      .left  { display: none; }
      .right { padding: 40px 28px; }
    }
  </style>
</head>
<body>

<div class="shell">

  <!-- ──────────── LEFT ──────────── -->
  <div class="left">
    <div class="brand">
      <a href="/" class="logo">
        <div class="logo-mark">
          <svg viewBox="0 0 18 18" fill="none" width="18" height="18">
            <path d="M9 2L16 6V12L9 16L2 12V6L9 2Z" stroke="#c9a96e" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M9 2V16M2 6L16 12M16 6L2 12" stroke="#c9a96e" stroke-width="0.7" opacity="0.5"/>
          </svg>
        </div>
        <span class="logo-name">Axiom</span>
      </a>
    </div>

    <!-- Steps -->
    <div class="steps-block">
      <div class="steps-label">Recovery steps</div>
      <div class="steps" id="stepList">

        <div class="step active" id="step1">
          <div class="step-dot">1</div>
          <div class="step-body">
            <div class="step-title">Enter your email</div>
            <div class="step-desc">We'll look up your account and send a secure reset link.</div>
          </div>
        </div>

        <div class="step inactive" id="step2">
          <div class="step-dot">2</div>
          <div class="step-body">
            <div class="step-title">Check your inbox</div>
            <div class="step-desc">Open the email from Axiom and click the reset link — valid for 15 minutes.</div>
          </div>
        </div>

        <div class="step inactive" id="step3">
          <div class="step-dot">3</div>
          <div class="step-body">
            <div class="step-title">Set a new password</div>
            <div class="step-desc">Choose something strong and you're back in your workspace.</div>
          </div>
        </div>

      </div>
    </div>

    <div class="footer-note">© 2025 Axiom Inc. All rights reserved.</div>
  </div>

  <!-- ──────────── RIGHT ──────────── -->
  <div class="right">

    <%# ── EJS: Flash messages from Express session ── %>
    <% if (locals.success) { %>
      <div class="flash flash-success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <%= success %>
      </div>
    <% } %>

    <% if (locals.error) { %>
      <div class="flash flash-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <%= error %>
      </div>
    <% } %>

    <%# ── Email sent confirmation view ── %>
    <% if (locals.emailSent) { %>
      <div class="sent-view visible" id="sentView">
        <div class="sent-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3ecf8e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.61 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l.81-.81a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <h2 class="sent-title">Check your inbox</h2>
        <p class="sent-desc">
          We've sent a password reset link to your email address. The link will expire in <strong style="color:var(--text)">15 minutes</strong>.
        </p>
        <div class="sent-email-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="color:var(--subtle)">
            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <%= locals.sentEmail || 'your email address' %>
        </div>
        <div class="resend-row">
          Didn't receive it?&nbsp;
          <button type="button" id="resendBtn">Resend email</button>
        </div>
        <div style="margin-top:28px;">
          <a href="/login" class="back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Back to Sign In
          </a>
        </div>
      </div>

    <% } else { %>

    <%# ── Main forgot-password form ── %>
    <div class="form-view" id="formView">

      <a href="/login" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Back to Sign In
      </a>

      <div class="form-tag">Account recovery</div>
      <h2 class="form-title">Forgot your<br><em>password?</em></h2>
      <p class="form-desc">
        No worries. Enter the email address linked to your account and we'll send you a secure reset link instantly.
      </p>

      <form action="/forgot-password" method="POST" id="forgotForm">

        <div class="field">
          <label for="email">Email address</label>
          <div class="field-wrap">
            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
              value="<%= locals.oldEmail || '' %>"
            />
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <span class="field-hint">We'll only use this to send your reset link.</span>
        </div>

        <%# CSRF token if using csurf middleware %>
        <% if (locals.csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% } %>

        <button type="submit" class="btn-submit" id="submitBtn">
          <span class="btn-inner btn-text">
            Send Reset Link
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
              <path d="M22 2 11 13M22 2 15 22l-4-9-9-4 20-7z"/>
            </svg>
          </span>
          <div class="spinner"></div>
        </button>

        <p class="form-footer">
          Remembered it? <a href="/login">Sign in instead</a>
        </p>

      </form>
    </div>

    <% } %>

  </div><!-- .right -->
</div><!-- .shell -->

<script>
  /* ── Loading state on submit ── */
  const form      = document.getElementById('forgotForm');
  const submitBtn = document.getElementById('submitBtn');

  if (form) {
    form.addEventListener('submit', () => {
      submitBtn.classList.add('loading');
      submitBtn.disabled = true;
    });
  }

  /* ── Resend cooldown ── */
  const resendBtn = document.getElementById('resendBtn');
  if (resendBtn) {
    resendBtn.addEventListener('click', () => {
      resendBtn.disabled = true;
      let secs = 30;
      resendBtn.textContent = `Resend in ${secs}s`;
      const t = setInterval(() => {
        secs--;
        if (secs <= 0) {
          clearInterval(t);
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend email';
        } else {
          resendBtn.textContent = `Resend in ${secs}s`;
        }
      }, 1000);

      /* fire the actual resend request */
      fetch('/forgot-password/resend', { method: 'POST' }).catch(() => {});
    });
  }

  /* ── Advance step indicator to step 2 after email is sent ── */
  <% if (locals.emailSent) { %>
    const s1 = document.getElementById('step1');
    const s2 = document.getElementById('step2');
    if (s1) { s1.classList.remove('active'); s1.classList.add('done'); }
    if (s2) { s2.classList.remove('inactive'); s2.classList.add('active'); }
  <% } %>
</script>

</body>
</html>
