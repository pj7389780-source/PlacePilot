<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Solution</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-base:        #0b0d11;
      --bg-surface:     #111318;
      --bg-elevated:    #161920;
      --bg-glass:       rgba(22, 25, 32, 0.72);
      --border-subtle:  rgba(255, 255, 255, 0.06);
      --border-mid:     rgba(255, 255, 255, 0.10);
      --border-accent:  rgba(255, 255, 255, 0.18);
      --text-primary:   #eef0f4;
      --text-secondary: #8b909e;
      --text-muted:     #555a67;
      --accent:         #5b8af0;
      --accent-dim:     rgba(91, 138, 240, 0.12);
      --accent-glow:    rgba(91, 138, 240, 0.25);
      --easy:           #3ecf8e;
      --easy-bg:        rgba(62, 207, 142, 0.10);
      --medium:         #f59e0b;
      --medium-bg:      rgba(245, 158, 11, 0.10);
      --hard:           #ef4444;
      --hard-bg:        rgba(239, 68, 68, 0.10);
      --shadow-card:    0 0 0 1px var(--border-subtle), 0 8px 32px rgba(0,0,0,0.45), 0 2px 8px rgba(0,0,0,0.30);
      --shadow-hover:   0 0 0 1px var(--border-mid), 0 16px 52px rgba(0,0,0,0.55), 0 4px 16px rgba(0,0,0,0.35), 0 0 60px rgba(91,138,240,0.05);
      --radius-card:    20px;
      --radius-inner:   12px;
      --radius-badge:   6px;
      --font-display:   'Syne', sans-serif;
      --font-body:      'Instrument Sans', sans-serif;
      --font-mono:      'JetBrains Mono', monospace;
    }

    html, body {
      min-height: 100vh;
      background-color: var(--bg-base);
      color: var(--text-primary);
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    body {
      background-image:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(91,138,240,0.10) 0%, transparent 70%),
        radial-gradient(ellipse 60% 40% at 80% 90%, rgba(91,138,240,0.05) 0%, transparent 60%);
      background-attachment: fixed;
    }

    .page-wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 48px 24px 80px;
      animation: fadeUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .top-bar {
      width: 100%;
      max-width: 860px;
      display: flex;
      align-items: center;
      margin-bottom: 36px;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--text-secondary);
      font-family: var(--font-body);
      font-size: 13.5px;
      font-weight: 500;
      letter-spacing: 0.02em;
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      background: rgba(255,255,255,0.03);
      transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.18s;
    }

    .back-btn:hover {
      color: var(--text-primary);
      border-color: var(--border-mid);
      background: rgba(255,255,255,0.06);
      transform: translateX(-2px);
    }

    .back-btn svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      flex-shrink: 0;
    }

    .solution-card {
      width: 100%;
      max-width: 860px;
      background: var(--bg-glass);
      backdrop-filter: blur(20px) saturate(1.3);
      -webkit-backdrop-filter: blur(20px) saturate(1.3);
      border-radius: var(--radius-card);
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-card);
      overflow: hidden;
      transition: box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .solution-card:hover {
      box-shadow: var(--shadow-hover);
      border-color: var(--border-mid);
      transform: translateY(-2px);
    }

    .card-header {
      padding: 36px 40px 32px;
      border-bottom: 1px solid var(--border-subtle);
      background: linear-gradient(135deg, rgba(91,138,240,0.04) 0%, transparent 60%);
      position: relative;
      overflow: hidden;
    }

    .card-header::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 40px;
      right: 40px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent-glow), transparent);
      border-radius: 999px;
    }

    .header-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .topic-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-body);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-dim);
      border: 1px solid rgba(91,138,240,0.18);
      padding: 4px 10px;
      border-radius: var(--radius-badge);
    }

    .difficulty-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-family: var(--font-body);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: var(--radius-badge);
    }

    .difficulty-badge::before {
      content: '';
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .badge-easy {
      color: var(--easy);
      background: var(--easy-bg);
      border: 1px solid rgba(62,207,142,0.22);
    }

    .badge-easy::before {
      background: var(--easy);
      box-shadow: 0 0 6px var(--easy);
    }

    .badge-medium {
      color: var(--medium);
      background: var(--medium-bg);
      border: 1px solid rgba(245,158,11,0.22);
    }

    .badge-medium::before {
      background: var(--medium);
      box-shadow: 0 0 6px var(--medium);
    }

    .badge-hard {
      color: var(--hard);
      background: var(--hard-bg);
      border: 1px solid rgba(239,68,68,0.22);
    }

    .badge-hard::before {
      background: var(--hard);
      box-shadow: 0 0 6px var(--hard);
    }

    .problem-title {
      font-family: var(--font-display);
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      line-height: 1.25;
    }

    .card-body {
      padding: 0 40px 40px;
    }

    .section {
      padding-top: 32px;
    }

    .section + .section {
      border-top: 1px solid var(--border-subtle);
      padding-top: 28px;
      margin-top: 4px;
    }

    .section-label {
      display: flex;
      align-items: center;
      gap: 9px;
      font-family: var(--font-body);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-subtle);
    }

    .solution-block {
      background: var(--bg-base);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-inner);
      overflow: hidden;
    }

    .solution-block-inner {
      overflow-y: auto;
      max-height: 440px;
      padding: 24px 28px;
      scrollbar-width: thin;
      scrollbar-color: var(--border-mid) transparent;
    }

    .solution-block-inner::-webkit-scrollbar {
      width: 5px;
    }

    .solution-block-inner::-webkit-scrollbar-thumb {
      background: var(--border-mid);
      border-radius: 99px;
    }

    .solution-block-inner::-webkit-scrollbar-track {
      background: transparent;
    }

    pre {
      font-family: var(--font-mono);
      font-size: 13.5px;
      line-height: 1.75;
      color: #c9cdd8;
      white-space: pre-wrap;
      word-break: break-word;
      tab-size: 2;
    }

    .explanation-text {
      font-family: var(--font-body);
      font-size: 14.5px;
      line-height: 1.8;
      color: var(--text-secondary);
    }

    .complexity-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .complexity-card {
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-inner);
      padding: 20px 22px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: border-color 0.2s, background 0.2s;
    }

    .complexity-card:hover {
      border-color: var(--border-mid);
      background: rgba(255,255,255,0.02);
    }

    .complexity-type {
      font-family: var(--font-body);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .complexity-value {
      font-family: var(--font-mono);
      font-size: 17px;
      font-weight: 500;
      color: var(--text-primary);
      letter-spacing: 0.01em;
    }

    .complexity-value span {
      color: var(--accent);
    }

    @media (max-width: 640px) {
      .page-wrapper {
        padding: 28px 16px 60px;
      }

      .card-header {
        padding: 28px 24px 24px;
      }

      .card-body {
        padding: 0 24px 32px;
      }

      .solution-block-inner {
        padding: 18px 20px;
      }

      .complexity-grid {
        grid-template-columns: 1fr;
      }

      .header-meta {
        gap: 8px;
      }
    }
  </style>
</head>
<body>
  <div class="page-wrapper">

    <div class="top-bar">
      <a href="/dashboard" class="back-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Back to Dashboard
      </a>
    </div>

    <div class="solution-card">

      <div class="card-header">
        <div class="header-meta">
          <span class="topic-chip">topic</span>
          </div>
        <h1 class="problem-title"><%=problemtitle%></h1>
      </div>

      <div class="card-body">

        <div class="section">
          <div class="section-label">AI Generated Solution</div>
          <div class="solution-block">
            <div class="solution-block-inner">
              <pre><%=result%></pre>
            </div>
          </div>
        </div>

        <div class="section">
          <div class="section-label">Explanation</div>
          <p class="explanation-text"><%=explanation%></p>
        </div>

        <div class="section">
          <div class="section-label">Complexity Analysis</div>
          <div class="complexity-grid">
            <div class="complexity-card">
              <div class="complexity-type">Time Complexity</div>
              <div class="complexity-value"><span><%=timeComplexity%></span></div>
            </div>
            <div class="complexity-card">
              <div class="complexity-type">Space Complexity</div>
              <div class="complexity-value"><span><%=spaceComplexity%></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</body>
</html>
